generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  OWNER
}

enum RestaurantStatus {
  // Self-signed-up, still walking the onboarding wizard. Not orderable yet.
  PENDING
  ACTIVE
  SUSPENDED
}

/// Which pricing plan a tenant is on. Same product on all three — the only
/// thing that changes is who pays. See `lib/plans.ts`, which is the one place
/// that turns this into money.
enum Plan {
  /// $0/month. A disclosed service fee rides on the customer's ticket.
  ZERO
  /// $399/month, paid by the owner. Nothing on the customer's ticket.
  FLAT
  /// $149/month plus 4% of each order, out of the restaurant's own proceeds.
  HYBRID
}

enum OrderStatus {
  RECEIVED
  ACCEPTED
  PREPARING
  READY
  COMPLETED
  CANCELED
  // The kitchen declined before ever starting the food. Split out from
  // CANCELED because the two mean different things to a customer ("we never
  // took this" vs "we stopped partway") and the refund is always full.
  REJECTED
}

/// Why an order stopped, or why money went back. Kept as an enum rather than
/// free text because these drive customer-facing copy, refund policy, and the
/// reliability metrics an owner gets judged on.
enum OrderProblem {
  OUT_OF_STOCK // one or more items 86'd after the order landed
  CLOSING_SOON // ticket arrived too late to make
  CLOSED // restaurant was shut and shouldn't have taken it
  TOO_BUSY // kitchen at capacity
  KITCHEN_ISSUE // equipment down, staffing, fire alarm
  WEATHER // storm, power cut
  CUSTOMER_REQUEST // customer changed their mind
  NO_SHOW // food made, never collected
  PRICING_ERROR // menu was wrong
  DUPLICATE_ORDER
  QUALITY // remake or goodwill after the fact
  OTHER
}

/// Who pulled the trigger. Matters for disputes and for whether a cancellation
/// counts against the restaurant's reliability.
enum ActorKind {
  CUSTOMER
  RESTAURANT
  SYSTEM // auto-expiry, auto-reject when closed
  ADMIN
}

enum RefundStatus {
  PENDING
  SUCCEEDED
  FAILED
}

/// A customer-reported problem with an order that already happened. Distinct
/// from a cancellation: the food may have been handed over and still be wrong.
enum IssueKind {
  MISSING_ITEM
  WRONG_ITEM
  QUALITY
  LONG_WAIT
  CLOSED_ON_ARRIVAL
  NEVER_RECEIVED
  CHARGED_WRONG
  OTHER
}

enum IssueStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
  DECLINED
}

enum OptInStatus {
  UNKNOWN
  OPTED_IN
  OPTED_OUT
}

enum Cohort {
  TREATMENT
  HOLDOUT
}

enum MessageKind {
  FIRST_REORDER
  WIN_BACK
  FREQUENCY
  TRANSACTIONAL
  /// A message an owner composed and sent to an audience they picked. Every
  /// other kind is the system speaking on the restaurant's behalf; this one is
  /// the restaurant speaking. Marketing, so it passes the same consent gate as
  /// the rest — see lib/sms.ts and lib/email.ts.
  CAMPAIGN
  /// A message a standing automation decided to send. Marketing, so it passes
  /// the same gate — kept distinct from CAMPAIGN because "the restaurant sent
  /// this on Tuesday" and "a journey the restaurant drew in March sent this"
  /// are different answers to a complaint, and the outbox is where either is
  /// looked up.
  AUTOMATION
}

/// Which wire a message went out on.
///
/// Deliberately a column on `Message` rather than a second table. "What did we
/// send this person, and did it arrive" is one question, and answering it from
/// two outboxes means every support view, every retry sweep and every consent
/// audit has to remember to look in both. The consent *rules* differ by channel
/// — see lib/email.ts — but the record of what happened does not.
enum MessageChannel {
  SMS
  EMAIL
}

enum MediaKind {
  ITEM
  LOGO
  HERO
}

enum MessageStatus {
  QUEUED
  SENT
  FAILED
  SKIPPED
  DELIVERED
  UNDELIVERED
}

/// Where a campaign is in its life.
///
/// The transitions that matter are the ones that must not be reversible.
/// `SENDING` is the point of no return: recipient rows exist and some of them
/// have already left the building, so "cancel" from there stops the *rest* and
/// is recorded as CANCELED — it does not and cannot unsend. A status machine
/// in lib/campaigns.ts enforces the edges, for the same reason lib/orders.ts
/// has one: the counts hanging off a campaign are only trustworthy if the
/// status they describe couldn't have moved sideways.
enum CampaignStatus {
  DRAFT
  SCHEDULED
  SENDING
  SENT
  CANCELED
  FAILED
}

model Restaurant {
  id     String           @id @default(cuid())
  slug   String           @unique
  name   String
  status RestaurantStatus @default(PENDING)

  // Custom domain (BYO). The tenant points this hostname at the service and it
  // serves their website + ordering flow. Null until an owner adds one.
  // Only routes once verified — domainVerifiedAt is the gate.
  customDomain      String?   @unique
  domainVerifiedAt  DateTime?
  // Random challenge the owner publishes as a TXT record to prove ownership.
  // Legacy: kept for tenants onboarded before Cloudflare for SaaS.
  domainVerifyToken String?

  // Cloudflare for SaaS custom hostname. We register the tenant's domain with
  // Cloudflare, which issues the cert and proxies to us — so the owner never
  // needs access to our hosting account. cfHostnameId is the handle we poll.
  cfHostnameId String?
  cfStatus     String? // pending | active | ... (Cloudflare routing status)
  cfSslStatus  String? // pending_validation | active | ... (cert status)

  /// The `www.` twin, registered alongside an apex domain.
  ///
  /// Routing already tolerates www — `customDomainFromHost` strips it — but
  /// Cloudflare issues a certificate per hostname, so without a second
  /// registration a visitor typing www gets a TLS error rather than a redirect.
  /// A browser warning on the owner's own domain is worse than no domain.
  /// Null for subdomains, where nobody types www.order.theirplace.com.
  cfWwwHostnameId String?
  cfWwwStatus     String?
  cfWwwSslStatus  String?

  // --- Plan and subscription --------------------------------------------
  //
  // `plan` is what they are on now; `pendingPlan` is a switch scheduled for the
  // billing boundary. Reads go through `effectivePlan` in `lib/plans.ts` rather
  // than touching these columns directly, because a scheduled switch has to
  // apply on its own date whether or not the sweep that materialises it ran.
  plan        Plan  @default(ZERO)
  pendingPlan Plan?

  /// End of the paid period. Null on ZERO, which has no billing period, and
  /// also the date a `pendingPlan` becomes real.
  planPeriodEnd DateTime?

  /// When a subscription payment first failed. Starts the grace clock; cleared
  /// on a successful payment. Fourteen days later the tenant drops to ZERO
  /// rather than being suspended — a restaurant that cannot hand over food it
  /// already made is a disproportionate response to an expired card.
  planPastDueSince DateTime?

  /// Stripe objects on the **platform** account, not the tenant's connected
  /// one. This is the one place money flows towards us rather than through us,
  /// so these deliberately do not share a column with `stripeAccountId`.
  stripeCustomerId     String?
  stripeSubscriptionId String?

  /// Last four and brand of the card on file, for display only. Never the card.
  planCardBrand String?
  planCardLast4 String?

  planChanges PlanChange[]

  // Onboarding: highest wizard step completed. 0 = nothing yet.
  onboardingStep Int       @default(0)
  onboardedAt    DateTime?

  // --- Done-for-you reordering ------------------------------------------
  //
  // The owner's answer to "shall we run reordering campaigns for you?" plus the
  // intensity dial. Two columns, not one, on purpose: "off" and "which level"
  // are different questions, so turning it off preserves the tuned level. Read
  // both through `reorderConfigFor` in `lib/reorder.ts`, never in isolation —
  // the same pairing as `cardPaymentsEnabled` / `cardPaymentsAllowed()`.
  reorderCampaigns Boolean @default(false)
  /// LIGHT | MEDIUM | HEAVY. A plain String, not an enum, so a level can be
  /// renamed without migrating every row; `coerceMode` maps anything unknown to
  /// the recommended default. Only meaningful when `reorderCampaigns` is true.
  reorderMode      String  @default("MEDIUM")
  /// When the owner last answered the onboarding reordering question. The step
  /// is required-to-answer but NOT launch-gating, so this timestamp — not the
  /// onboarding gate — is what tells the dashboard whether to keep nagging.
  reorderChoiceAt  DateTime?

  bookings        Booking[]
  menuSubmissions MenuSubmission[]

  // Branding
  logoUrl     String?
  heroUrl     String?
  accentColor String  @default("#3b82f6")
  tagline     String?

  // Website customization (the /r/[slug] landing site). All optional so a
  // restaurant that touches none of it still gets a sensible default page.
  heroHeadline String?  // overrides the big hero title; falls back to name
  heroCtaLabel String?  // primary button text; falls back to "Order pickup"
  aboutTitle   String?  // heading for the About section
  aboutBody    String?  // paragraph for the About section
  galleryUrls  String[] @default([]) // extra photos shown in a gallery strip
  showAbout    Boolean  @default(true)
  showGallery  Boolean  @default(true)
  theme        String   @default("SYSTEM") // LIGHT | DARK | SYSTEM (follow device)
  /// Which look the storefront wears — see src/lib/store-theme.ts.
  ///
  /// A plain String rather than an enum on purpose: a preset can be added or
  /// renamed without a migration touching every tenant row. The cost is that a
  /// removed preset leaves rows pointing at nothing, so `storeTheme()` coerces
  /// an unknown value back to Classic. The storefront must never be the thing
  /// that discovers a preset went away.
  themePreset  String   @default("classic")
  siteContent  Json     @default("{}") // editable template copy — see lib/site-content.ts

  // Info
  address String?
  city    String?
  phone   String?

  /// The tenant's own SMS sending number, E.164. Per-tenant because A2P 10DLC
  /// registers a brand per business, and because an inbound STOP arrives
  /// addressed only to the number that sent the original — making this the
  /// only route from a delivery receipt back to a restaurant. Null until
  /// registration clears; falls back to the platform messaging service.
  smsFrom String? @unique

  /// --- Email sender identity ---------------------------------------------
  ///
  /// The name and address marketing email goes out as. Per-tenant because the
  /// customer opted into a relationship with the restaurant, not with us, and
  /// mail that says "EZ Orders" in the from-line gets marked as spam by people
  /// who would happily have read it from the restaurant.
  ///
  /// `emailFrom` must be an address on a domain verified with the email
  /// provider — SendGrid rejects anything else, and unverified sending is how
  /// a shared IP pool gets blocklisted for every tenant on it. Null until
  /// verification clears; `lib/email.ts` falls back to the platform sender and
  /// records the tenant in the from-name so the mail is still honest about who
  /// sent it.
  emailFrom     String?
  emailFromName String?
  /// Where replies go. Usually the restaurant's real inbox — the platform
  /// sending domain has nobody reading it, and a marketing email a customer
  /// cannot reply to is a worse experience than no email.
  emailReplyTo  String?
  /// Set when the sending domain or single sender has been verified with the
  /// provider. Ours to write, not the owner's — it mirrors provider state.
  emailSenderVerifiedAt DateTime?

  /// Postal address printed in the footer of every marketing email, because
  /// CAN-SPAM requires a physical address and the restaurant's own is the
  /// truthful one. Falls back to the address/city columns above.
  emailFooterAddress String?

  /// The tenant's Stripe Connect account id (`acct_...`). Charges are created
  /// *on* this account (direct charges), so funds settle here, Stripe's
  /// processing fee comes out of their balance, and the surcharge rides back
  /// to us as an application_fee_amount. The owner's payout is untouched and
  /// our fee isn't eaten by processing costs — which it would be if the charge
  /// were ours. Null until the owner completes Connect onboarding —
  /// in test mode that's harmless (charges land on the platform), but going
  /// live without it would route the whole bill to us, which config-check
  /// refuses. See lib/payments-stripe.ts.
  stripeAccountId String? @unique

  /// Mirror of the connected account's readiness, refreshed from Stripe after
  /// onboarding. `stripeChargesEnabled` is the one that actually gates a live
  /// direct charge; the other two drive what the owner is told to finish.
  /// Cached rather than fetched per request — the owner-facing status page can
  /// be stale by a refresh-click without any money being at stake.
  stripeChargesEnabled   Boolean @default(false)
  stripePayoutsEnabled   Boolean @default(false)
  stripeDetailsSubmitted Boolean @default(false)

  /// Owner's switch for taking cards online. Off means the storefront collects
  /// no card and the order is pay-at-counter — which also means no surcharge is
  /// collected, so it is a real revenue decision, deliberately left to them.
  cardPaymentsEnabled Boolean @default(true)

  /// Owner's switch for offering delivery. Defaults **off**: this platform
  /// sells pickup, and a restaurant that hasn't thought about drivers, zones,
  /// and a longer promised time should not discover delivery switched on for
  /// them. Pairs with a DELIVERY ServiceSuspension the same way
  /// `cardPaymentsEnabled` pairs with PAYMENTS — read `deliveryAllowed()`,
  /// never this column alone.
  ///
  /// Nothing in the ordering flow reads this yet. It exists so the switch and
  /// its suspension are in place before the feature lands, not because
  /// delivery works — see docs/post-order-gaps.md.
  deliveryEnabled Boolean @default(false)

  /// Human-readable hours, shown on the website. Display only — never used to
  /// decide whether ordering is open. See hoursJson for that.
  hours   String?

  // --- Ordering availability -------------------------------------------
  // The single most common post-order failure is an order that should never
  // have been accepted. These fields exist so the platform can refuse it up
  // front instead of apologizing afterwards.

  /// Machine-readable weekly schedule. Shape is validated in lib/hours.ts:
  ///   { "mon": [{ "open": "11:00", "close": "21:00" }], ... }
  /// An empty object means "no schedule configured" — see acceptsOrdersNow(),
  /// which fails open so a tenant that never touched this keeps trading.
  hoursJson Json @default("{}")

  /// IANA zone. Every open/closed decision is made in the restaurant's local
  /// time, not the server's and not the customer's.
  timezone String @default("America/New_York")

  /// Kitchen's own kill switch: "stop taking orders until X". Set by the
  /// pause button, cleared automatically once the timestamp passes.
  pausedUntil  DateTime?
  pauseReason  String?

  /// Typical minutes from order to ready. Drives the promised pickup time the
  /// customer is quoted, which is what they actually judge you on.
  prepMinutes Int @default(20)

  /// Stop accepting orders this many minutes before close, so a ticket never
  /// lands with no time to cook it.
  lastCallMins Int @default(20)

  /// When true a new order goes straight to ACCEPTED. When false it waits in
  /// RECEIVED for a human, and auto-expires if nobody touches it.
  autoAccept Boolean @default(true)

  /// Minutes an unaccepted order may sit before the system cancels and
  /// refunds it. Nothing is worse than silence.
  autoExpireMins Int @default(10)

  // Pricing levers — the surcharge is the revenue model, configured per tenant.
  surchargePct     Float @default(0.035) // fraction of subtotal
  surchargeMinCts  Int   @default(100) // $1.00 floor
  surchargeMaxCts  Int   @default(2000) // $20.00 ceiling
  taxPct           Float @default(0.06)
  surchargeLabel   String @default("Service fee")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users      User[]
  categories MenuCategory[]
  items      MenuItem[]
  customers  Customer[]
  customerAccounts CustomerAccount[]
  orders     Order[]
  messages   Message[]
  supportLogs SupportLog[]
  supportTickets SupportTicket[]
  mediaAssets MediaAsset[]
  closures    Closure[]
  issues      OrderIssue[]
  suspensions ServiceSuspension[]
  invites     Invite[]
  visits      Visit[]
  visitEvents VisitEvent[]
  customerTags     CustomerTag[]
  customerSegments CustomerSegment[]
  customerNotes    CustomerNote[]
  importJobs       CustomerImportJob[]
  campaigns        Campaign[]
  automations      Automation[]
  enrollments      AutomationEnrollment[]
  onboardingTasks  OnboardingTask[]
  onboardingNotes  OnboardingNote[]

  @@index([status])
}

/// One step of the **manual** onboarding checklist, per tenant.
///
/// Not to be confused with `lib/readiness.ts`, which *derives* facts the
/// database already knows (has a menu, has hours). This table records the
/// human steps of walking a restaurant through setup — "tested a live order",
/// "walked the owner through the board", "call attended" — none of which can be
/// derived, because they happened on a phone call rather than in a row. The
/// step *list* is code (`lib/onboarding-checklist.ts`); this is only the
/// per-tenant completion state, so a step can be added or renamed without a
/// migration touching every tenant.
///
/// One row per (restaurant, step key), created on first tick. `key` is a String
/// rather than an enum for the same reason `themePreset` is: the catalog lives
/// in code and a removed key just leaves an ignored row.
model OnboardingTask {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  /// Matches a step `key` in `lib/onboarding-checklist.ts`.
  key  String
  done Boolean @default(false)

  /// Who ticked it, for the "what's happening with this account" question.
  /// SetNull-in-spirit: we store the name, not a hard FK to a user row.
  completedByName String?
  completedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([restaurantId, key])
  @@index([restaurantId])
}

/// An admin's running note on a tenant's onboarding — "left a voicemail",
/// "waiting on their Stripe verification", "menu photos are blurry, asked for
/// better ones". **Ours, never the tenant's**, the same rule `CustomerAdminNote`
/// and `SupportNote` carry: a separate table rather than a visibility flag, so a
/// candid note is never one forgotten `where` clause away from the owner. Nothing
/// under `src/app/dashboard/` may select from this table.
model OnboardingNote {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  /// Which stream this note belongs to: "onboarding" (working notes while we get
  /// them live) or "account" (ongoing notes once they're trading). Two streams
  /// on one table rather than two tables — both are admin-only notes about a
  /// tenant with identical shape and access rules, so a discriminator is honest
  /// where the `CustomerNote`/`CustomerAdminNote` split isn't (those differ in
  /// *who can read them*; these don't). A plain String, not an enum, so a new
  /// stream needs no migration.
  kind String @default("onboarding")

  authorUserId String?
  authorName   String?

  body String

  createdAt DateTime @default(now())

  @@index([restaurantId, kind, createdAt])
}

/// A single-use, expiring link that provisions an owner's login.
///
/// Replaces handing someone a password over the phone. The recipient sets their
/// own password on redemption, so no plaintext credential exists anywhere —
/// not in our database, not in an admin's sent messages, not in a note.
///
/// SECURITY: `tokenHash` is a SHA-256 of the token, and the token itself is
/// returned exactly once at creation and never stored. A leaked database backup
/// therefore contains no usable invites. The lookup is by hash, so there is no
/// prefix to enumerate against.
model Invite {
  id String @id @default(cuid())

  /// SHA-256 of the 160-bit token. Unique so redemption is a single indexed
  /// read and a race can't match two rows.
  tokenHash String @unique

  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  /// Who the invite is for. The account is created at redemption, not now —
  /// an unredeemed invite leaves no login to be brute-forced.
  email String
  role  Role   @default(OWNER)

  expiresAt DateTime
  createdAt DateTime @default(now())
  createdById String?

  /// Set once, by the redemption path, under an optimistic lock. Non-null is
  /// what "already used" means; rows are never deleted on use because "who did
  /// we invite, when, and did they ever accept" is the onboarding audit trail.
  redeemedAt DateTime?
  redeemedById String?

  /// Cleared by the admin without redeeming — a typo'd address, a deal that
  /// fell through. Distinct from expiry so the reason is legible later.
  revokedAt DateTime?

  @@index([restaurantId, redeemedAt])
  @@index([email])
}

/// Every uploaded byte gets a row. The render path still reads the plain
/// *Url string columns, so this table is a ledger for provenance, storage
/// accounting, and orphan cleanup — not a foreign key everything hangs off.
model MediaAsset {
  id String @id @default(cuid())

  /// Null while an admin uploads branding for a restaurant that does not
  /// exist yet; backfilled when the restaurant is created.
  restaurantId String?
  restaurant   Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  /// Storage key, e.g. "clx123/ITEM/clx456.webp". Unique per provider.
  key String @unique
  /// Public URL, i.e. /api/media/<key>. This is what lands in imageUrl etc.
  url String @unique

  kind     MediaKind
  mimeType String
  bytes    Int
  width    Int
  height   Int

  /// Set by the GC script when the URL is no longer referenced anywhere.
  orphanedAt DateTime?

  createdAt   DateTime @default(now())
  createdById String?

  @@index([restaurantId])
  @@index([orphanedAt])
}

model User {
  id           String  @id @default(cuid())
  email        String  @unique
  passwordHash String
  name         String?
  role         Role    @default(OWNER)

  /// Optional E.164 number for operator (admin/owner) SMS alerts. This is not a
  /// diner's number and never touches the customer consent gate — an operator
  /// asking to be texted about their own account is the same transactional case
  /// as the password-reset email. Null means "SMS alerts unavailable", so a
  /// notification whose resolved channel includes SMS simply skips the wire.
  phone        String?

  restaurantId String?
  restaurant   Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  supportTickets SupportTicket[]
  oauthIdentities OAuthIdentity[]
  passwordResets PasswordResetToken[]
  loginEvents    LoginEvent[]
  activityEvents ActivityEvent[]
  notifications      Notification[]
  notificationPrefs  NotificationPref[]

  @@index([restaurantId])
}

/// How a session was established. Mirrors the four doors that call `setSession`
/// (password login, self-serve signup, invite redemption, OAuth) plus the
/// admin's impersonation swap, which is a real session change worth seeing in
/// the history even though it isn't a fresh authentication.
enum LoginMethod {
  PASSWORD
  SIGNUP
  INVITE
  OAUTH
  IMPERSONATE
}

/// One row per operator authentication. This is the "when did they log in and
/// how often" half of the login history — an append-only ledger, never updated
/// or deleted, so recency and frequency stay answerable after the fact.
///
/// Deliberately its own table rather than a `lastLoginAt` column on `User`: a
/// single timestamp answers "when did they last sign in" and nothing else, and
/// this feature is the questions a single timestamp can't answer.
///
/// `ip` and `userAgent` are best-effort forensics for an account-takeover
/// question later; both are nullable because a header can be absent or spoofed
/// and neither is ever an auth decision.
model LoginEvent {
  id     String      @id @default(cuid())
  userId String
  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  method LoginMethod
  ip        String?
  userAgent String?
  at     DateTime @default(now())

  @@index([userId, at])
  @@index([at])
}

/// One row per authenticated page load, written at the `requireAdmin` /
/// `requireOwner` choke point every admin and dashboard page already passes
/// through. This is the "what do they spend time doing while logged in" half:
/// a feed of paths and timestamps from which session duration is reconstructed
/// at query time by grouping consecutive events (an idle gap ends a session).
///
/// There is no free-form `meta` bag on purpose — the same rule the storefront
/// analytics ingest follows. A path and a method are fixed typed columns; an
/// open field is how something that shouldn't be logged ends up logged, and
/// then it's in every backup.
model ActivityEvent {
  id     String   @id @default(cuid())
  userId String
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// The pathname of the page (or the target of a server action). Query strings
  /// are stripped before write — they can carry a customer's email or a token.
  path   String
  method String   @default("GET")
  at     DateTime @default(now())

  @@index([userId, at])
  @@index([at])
}

/// A single-use, expiring password-reset link for an operator login.
///
/// Same security shape as `Invite`: the token is 160 bits from the CSPRNG, we
/// store only its SHA-256, and the raw value is emailed once and never kept —
/// a database backup therefore holds no usable reset links. Consuming it sets
/// `usedAt` under an optimistic lock so a double-tapped link can't reset twice,
/// and rows are never deleted, because "did someone request a reset, and was it
/// used" is what answers an account-takeover question later.
///
/// This is deliberately its own table and not a column on `User`: a reset in
/// flight must not overwrite the live credential, and an expired request should
/// leave no trace on the account it was for.
model PasswordResetToken {
  id String @id @default(cuid())

  /// SHA-256 of the token. Unique so the lookup is one indexed read and a race
  /// cannot match two rows.
  tokenHash String @unique

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  expiresAt DateTime
  createdAt DateTime  @default(now())
  usedAt    DateTime?

  @@index([userId])
}

/// A linked Google or Apple account for an operator login.
///
/// Sign-in only. A provider identity can never *create* a User — owner logins
/// have one door and it is an invite token (see `lib/invites.ts`). The rule is
/// enforced in `staffLinkDecision` in `lib/oauth.ts`, which is pure and tested;
/// this table only records the link once it has been allowed.
model OAuthIdentity {
  id       String  @id @default(cuid())
  provider String  // "google" | "apple"
  /// The provider's stable identifier. This is the key, not the email — people
  /// change the address on a Google account and it is still the same account.
  subject  String
  /// Recorded for support ("which address did they use"), never for matching
  /// after the first link.
  email    String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt   DateTime  @default(now())
  lastLoginAt DateTime?

  @@unique([provider, subject])
  @@unique([userId, provider])
  @@index([userId])
}

model MenuCategory {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  name String
  sort Int    @default(0)

  items MenuItem[]

  @@unique([restaurantId, name])
  @@index([restaurantId])
}

model MenuItem {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  categoryId String?
  category   MenuCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  name        String
  description String?
  priceCts    Int
  /// Optional sale price. When set and below priceCts, this is what the
  /// customer pays and priceCts renders struck-through as the "was" price.
  salePriceCts Int?
  imageUrl    String?
  color       String? // fallback tile color when no image
  available   Boolean @default(true)
  featured    Boolean @default(false)
  sort        Int     @default(0)

  orderItems     OrderItem[]
  modifierGroups ModifierGroup[]

  // Upsell / cross-sell recommendations. `links` are the items this one
  // suggests; `linkedFrom` is the reverse edge (kept only so deletes cascade).
  links      MenuItemLink[] @relation("itemLinks")
  linkedFrom MenuItemLink[] @relation("linkedFrom")

  visitEvents VisitEvent[]

  @@index([restaurantId])
  @@index([categoryId])
}

enum LinkKind {
  UPSELL // "make it bigger / add a side" — a natural step up
  CROSS_SELL // "goes well with" — a different item to add
}

/// A directed recommendation from one menu item to another.
model MenuItemLink {
  id String @id @default(cuid())

  itemId String
  item   MenuItem @relation("itemLinks", fields: [itemId], references: [id], onDelete: Cascade)

  linkedItemId String
  linkedItem   MenuItem @relation("linkedFrom", fields: [linkedItemId], references: [id], onDelete: Cascade)

  kind LinkKind
  sort Int      @default(0)

  @@unique([itemId, linkedItemId])
  @@index([itemId])
}

/// A question asked at the point of adding an item: "Size?", "Add-ons?".
/// Scoped to one item — sharing a group across items needs a join table and
/// isn't worth it until an owner asks for it.
///
/// minSelect/maxSelect encode the shape instead of a type enum:
///   size (required, pick one)  -> min 1, max 1   (radio)
///   add-ons (optional, any)    -> min 0, max n   (checkbox)
model ModifierGroup {
  id         String   @id @default(cuid())
  menuItemId String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  name String
  /// 0 means the group can be skipped.
  minSelect Int @default(0)
  /// 1 means single-choice. Higher allows multi-select up to that count.
  maxSelect Int @default(1)
  sort      Int @default(0)

  options ModifierOption[]

  @@index([menuItemId])
}

model ModifierOption {
  id      String        @id @default(cuid())
  groupId String
  group   ModifierGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  name String
  /// Added to the item's unit price. May be negative (e.g. "no cheese -$0.50").
  priceDeltaCts Int     @default(0)
  available     Boolean @default(true)
  /// Pre-selected when the sheet opens. Only meaningful for single-select.
  isDefault Boolean @default(false)
  sort      Int     @default(0)

  @@index([groupId])
}

model Customer {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  // The core asset.
  phone String
  name  String?
  email String?

  // TCPA proof — captured from day one even though SMS is stubbed.
  optInStatus OptInStatus @default(UNKNOWN)
  optInAt     DateTime?
  optInSource String? // e.g. "checkout_v1"
  optInText   String? // exact disclosure text shown at capture
  optOutAt    DateTime?

  // --- Email consent -----------------------------------------------------
  //
  // **Email is opt-out and SMS is opt-in, and that asymmetry is deliberate.**
  // It is not laziness and it is not a shortcut: the two channels are governed
  // by different law and have different failure modes.
  //
  //   - Texting without prior express written consent is a TCPA violation with
  //     statutory damages per message, and the operational punishment lands
  //     first: carriers filter the sending number and every *transactional*
  //     text stops arriving too. Hence `optInStatus`, which starts UNKNOWN and
  //     which an import can never move.
  //   - Email under CAN-SPAM requires accurate headers, a physical address and
  //     a working unsubscribe honoured promptly. It does not require prior
  //     consent. A restaurant emailing the customers on its own list is the
  //     ordinary, legal case, and requiring an opt-in nobody ever collected
  //     would make the channel useless on day one for exactly the tenants who
  //     have the biggest lists.
  //
  // So: no `emailOptInStatus` enum mirroring the SMS one. There is a single
  // suppression timestamp, and its absence means "may be emailed".
  //
  // Do not unify these two models. Whichever way they were unified would be
  // wrong — opt-in for email guts the feature, opt-out for SMS is illegal.

  /// When they unsubscribed from marketing email. Non-null suppresses every
  /// marketing send forever; transactional email is unaffected, exactly as
  /// CAN-SPAM contemplates. Set by the unsubscribe link, by an admin, or by a
  /// provider bounce/complaint webhook.
  emailOptOutAt DateTime?

  /// Why it was suppressed — "unsubscribed", "bounced", "complained",
  /// "admin". A hard bounce and a spam complaint both stop the sending, but
  /// only one of them is the customer telling us something, and an owner
  /// looking at a shrinking list deserves to know which.
  emailOptOutReason String?

  /// The unsubscribe link's credential. Random, 160 bits, minted lazily on the
  /// first marketing email and then stable, because a link in a message from
  /// last year has to keep working — a dead unsubscribe link is the specific
  /// thing that turns an annoyed reader into a spam complaint.
  ///
  /// A token rather than the customer id in the URL: an id is guessable and
  /// enumerable, and one-click unsubscribe means anybody who guessed one could
  /// silently suppress someone else's mail.
  emailUnsubToken String? @unique

  // Reserved for the treatment/holdout lift experiment.
  cohort Cohort @default(TREATMENT)

  firstOrderAt DateTime?
  lastOrderAt  DateTime?
  orderCount   Int      @default(0)
  lifetimeCts  Int      @default(0)

  createdAt DateTime @default(now())

  /// Which import created this row, if an import did. Null means the customer
  /// arrived through a real order.
  ///
  /// This is the undo marker, and it works the same way `paymentProvider:
  /// "sim"` does for the simulator: it is written **only on create**, never on
  /// a merge, so "rows this job invented" stays an exact set. An import that
  /// merely filled in a missing email on a customer who has been ordering for
  /// two years must not become deletable by undoing that import.
  importJobId String?
  importJob   CustomerImportJob? @relation(fields: [importJobId], references: [id], onDelete: SetNull)

  orders   Order[]
  rewards  RewardsLedger[]
  messages Message[]
  accounts CustomerAccount[]
  tags       CustomerTagLink[]
  notes      CustomerNote[]
  adminNotes CustomerAdminNote[]
  enrollments AutomationEnrollment[]

  @@unique([restaurantId, phone])
  @@index([restaurantId])
  @@index([cohort])
  @@index([restaurantId, importJobId])
  /// The columns the filter bar sorts and filters on. `lib/customers.ts`
  /// composes them, so the compound shapes match what it actually asks for.
  @@index([restaurantId, optInStatus])
  /// The email-audience predicate: has an address, hasn't unsubscribed.
  @@index([restaurantId, emailOptOutAt])
  @@index([restaurantId, lastOrderAt])
  @@index([restaurantId, orderCount])
  @@index([restaurantId, lifetimeCts])
}

/// A label an owner puts on their own customers — "VIP", "Catering", "Complained".
///
/// Tags belong to a tenant, always. There is no platform-wide tag vocabulary
/// and there shouldn't be: "regular" means something different at a taqueria
/// with 40 covers a day than at a bakery with 400, and a shared list would
/// force both to agree.
///
/// **A tag is not consent and can never become consent.** It is tempting to
/// let an owner tag a group and text it; the tag says nothing about whether
/// those people agreed to be texted. `lib/sms.ts` reads `optInStatus` and
/// nothing else, and a tag must never be plumbed into that decision. See
/// `docs/customer-import.md`.
model CustomerTag {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  /// What the owner typed, preserved for display.
  name String
  /// The dedupe key — lowercased, punctuation stripped. "VIP", "vip" and
  /// "V.I.P." are one tag, because an owner who ends up with three of them
  /// has a filter that silently returns a third of the people it should.
  slug String

  /// One of a fixed palette, resolved to `--h-*` tokens in the UI. Not a hex
  /// value: a free-text colour is how a tag ends up unreadable in dark mode,
  /// which `scripts/theme.test.ts` exists to prevent.
  color String @default("neutral")

  /// Tags we apply ourselves — currently the per-import tag. Owners can filter
  /// on them and delete them, but not rename them, because the name is a
  /// factual record of where those rows came from.
  system Boolean @default(false)

  createdAt DateTime @default(now())

  links      CustomerTagLink[]
  importJobs CustomerImportJob[]

  @@unique([restaurantId, slug])
  @@index([restaurantId])
}

model CustomerTagLink {
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tagId      String
  tag        CustomerTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([customerId, tagId])
  @@index([tagId])
}

/// A named filter combination — "lapsed VIPs", "never ordered twice".
///
/// Stored as the query string the filter bar produces rather than as typed
/// columns, so adding a filter doesn't need a migration. It's parsed back
/// through the same `readCustomerParams` every URL goes through, which means a
/// segment saved before a filter existed simply ignores it instead of failing.
model CustomerSegment {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  name  String
  /// A URL query string, e.g. `consent=OPTED_IN&tag=vip&lapsedDays=30`.
  query String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([restaurantId, name])
  @@index([restaurantId])
}

/// The owner's own note on a customer. Visible to the tenant, never to us.
model CustomerNote {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  customerId   String
  customer     Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)

  /// Who wrote it. SetNull so removing a staff account doesn't erase the note.
  authorUserId String?
  authorName   String?

  body String

  createdAt DateTime @default(now())

  @@index([customerId, createdAt])
  @@index([restaurantId])
}

/// Our note on a customer, for support. **A separate table from `CustomerNote`
/// on purpose**, for exactly the reason `SupportNote` is separate from
/// `SupportMessage`: a visibility boolean puts a candid internal note one
/// forgotten `where` clause away from the restaurant reading it, and that
/// clause would have to be correct in every query written from now on. Two
/// tables make the mistake unavailable rather than discouraged.
///
/// **Nothing under `src/app/dashboard/` may select from this table.**
model CustomerAdminNote {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  authorUserId String?
  authorName   String?

  body String

  createdAt DateTime @default(now())

  @@index([customerId, createdAt])
}

/// One customer-list upload. Exists so an import is undoable and so an owner
/// can see what a file actually did after the toast disappears.
model CustomerImportJob {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  filename String?

  created         Int @default(0)
  updated         Int @default(0)
  skipped         Int @default(0)
  duplicatesInFile Int @default(0)
  unusableRows    Int @default(0)

  /// The tag stamped on every row this job touched, created or merged. SetNull
  /// so deleting the tag doesn't delete the job's record of the upload.
  tagId String?
  tag   CustomerTag? @relation(fields: [tagId], references: [id], onDelete: SetNull)

  /// Set when the import is reversed. The row is kept rather than deleted —
  /// "we imported 900 people and took them back out" is the thing that
  /// explains a gap in the list six months later.
  undoneAt      DateTime?
  undoneCount   Int?

  createdAt DateTime @default(now())

  customers Customer[]

  @@index([restaurantId, createdAt])
}

model Order {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  number String // human-facing, e.g. A-8242
  status OrderStatus @default(RECEIVED)

  /// Unguessable key for the customer-facing status page at /o/[token].
  /// A pickup order has no account behind it, so this link *is* the auth —
  /// which is why it's random and long rather than the order id.
  publicToken String @unique

  subtotalCts  Int
  surchargeCts Int
  taxCts       Int
  totalCts     Int

  fulfillment String  @default("pickup")
  notes       String?

  // Payment seam — stub provider fills these without charging.
  paymentProvider  String?
  paymentReference String?
  paymentStatus    String  @default("stub_succeeded")

  /// Running total actually sent back to the customer. Every refund path
  /// checks this against totalCts so the same order can never be refunded
  /// twice, or for more than was charged.
  refundedCts Int @default(0)

  // --- Lifecycle ---------------------------------------------------------
  /// When we told the customer it would be ready. The promise, kept separate
  /// from when it actually was, so lateness is measurable.
  promisedAt  DateTime?
  acceptedAt  DateTime?
  readyAt     DateTime?
  completedAt DateTime?
  canceledAt  DateTime?

  /// Why it ended badly, and who ended it. Null on a clean order.
  problem     OrderProblem?
  problemNote String?
  endedBy     ActorKind?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items   OrderItem[]
  events  OrderEvent[]
  refunds Refund[]
  issues  OrderIssue[]
  visits  Visit[]

  @@unique([restaurantId, number])
  @@index([restaurantId, createdAt])
  @@index([restaurantId, status])
  @@index([customerId])
}

/// Append-only history of everything that happened to an order. The customer
/// sees a friendly slice of this as a timeline; support and disputes get the
/// whole thing. Never updated, never deleted.
model OrderEvent {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  /// e.g. "placed", "accepted", "item_86d", "refund_issued", "issue_reported".
  kind  String
  actor ActorKind

  /// Status before and after, when this event was a transition.
  fromStatus OrderStatus?
  toStatus   OrderStatus?

  /// Short line safe to show the customer. Null means internal-only.
  publicNote String?
  /// Anything else worth keeping: refund ids, item ids, actor user id.
  meta Json @default("{}")

  createdAt DateTime @default(now())

  @@index([orderId, createdAt])
}

/// Money going back. One row per attempt so a failed refund stays visible
/// rather than silently disappearing.
model Refund {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  amountCts Int
  reason    OrderProblem
  note      String?
  status    RefundStatus @default(PENDING)

  /// Whether the service fee was handed back too. On a restaurant-caused
  /// failure it always is — charging someone for an order you couldn't make
  /// is how you lose them permanently.
  includedSurcharge Boolean @default(false)

  provider    String?
  providerRef String?
  error       String?

  issuedBy   ActorKind @default(RESTAURANT)
  issuedById String?

  createdAt   DateTime  @default(now())
  succeededAt DateTime?

  /// How many times the owner has re-tried this payout. Kept so a provider
  /// that is failing every attempt looks different from one that blipped once.
  attempts Int @default(0)

  /// Set when a FAILED refund stops being outstanding — either a retry went
  /// through or the owner settled it in cash and said so. Until then the
  /// dashboard refuses to stop shouting about it: an order that owes a
  /// customer money is the one state nobody may quietly ignore.
  resolvedAt   DateTime?
  resolvedNote String?

  @@index([orderId])
  /// Drives the outstanding-refunds banner, which loads on every dashboard hit.
  @@index([status, resolvedAt])
}

/// A problem the customer reports after the fact. Lives separately from the
/// order's own status because an order can be COMPLETED and still be wrong.
model OrderIssue {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  kind   IssueKind
  status IssueStatus @default(OPEN)
  body   String

  /// What the restaurant did about it, shown back to the customer.
  resolution   String?
  resolvedAt   DateTime?
  acknowledgedAt DateTime?

  createdAt DateTime @default(now())

  @@index([restaurantId, status])
  @@index([orderId])
}

/// A date the restaurant is shut regardless of the weekly schedule —
/// holidays, a private event, a burst pipe. Beats editing hours and
/// forgetting to put them back.
model Closure {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  /// Inclusive local-date range, stored as YYYY-MM-DD to dodge timezone drift
  /// on what is fundamentally a calendar concept, not an instant.
  startDate String
  endDate   String

  reason String?

  createdAt DateTime @default(now())

  @@index([restaurantId, startDate])
}

model OrderItem {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  menuItemId String?
  menuItem   MenuItem? @relation(fields: [menuItemId], references: [id], onDelete: SetNull)

  name        String
  /// Base item price at the time of ordering.
  unitPriceCts Int
  /// Sum of the selected modifier deltas, per unit.
  modifiersCts Int @default(0)
  qty         Int
  notes       String?

  /// How many of this line the kitchen could actually make. Null means "all
  /// of them" — the normal case. A number below qty is a partial 86, and the
  /// difference is what gets refunded. Kept per-line so the customer still
  /// gets the rest of their order instead of losing the whole thing.
  fulfilledQty Int?

  modifiers OrderItemModifier[]

  @@index([orderId])
}

/// Snapshot of what was actually chosen. Denormalized on purpose: editing the
/// menu later must never rewrite what a customer was charged for.
model OrderItemModifier {
  id          String    @id @default(cuid())
  orderItemId String
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  groupName     String
  optionName    String
  priceDeltaCts Int
  /// Kept for analytics; may point at a deleted option.
  optionId String?

  @@index([orderItemId])
}

model RewardsLedger {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  points Int
  reason String
  orderId String?

  createdAt DateTime @default(now())

  @@index([customerId])
}

model Message {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  kind   MessageKind
  status MessageStatus @default(QUEUED)
  body   String

  /// SMS or email. Defaults to SMS so every row written before this column
  /// existed is correctly labelled without a backfill guess — they were all
  /// texts, because email had no sender.
  channel MessageChannel @default(SMS)

  /// Email subject line. Null on SMS, where there is no such thing, and
  /// required by lib/email.ts on the way out — a blank subject is the single
  /// strongest spam signal a new sending domain can emit.
  subject String?

  /// The campaign that produced this, when one did. Null for transactional
  /// mail and for the lifecycle kinds, which nobody composed.
  ///
  /// SetNull rather than Cascade: deleting a campaign must not delete the
  /// record of what was sent. The consent audit — who did we contact, when,
  /// on what basis — outlives the owner's tidying of their campaign list, and
  /// it is the thing that answers a carrier complaint.
  campaignId String?
  campaign   Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  /// The automation and the specific journey that produced this, when one did.
  ///
  /// Both SetNull for the same reason `campaignId` is: the record of who we
  /// contacted and on what basis has to outlive the owner deleting the
  /// automation. `enrollmentId` is what lets the journey inspector show a
  /// person's messages in the order their journey sent them — the automation
  /// alone can't, because the same person may have been through it twice.
  automationId String?
  automation   Automation? @relation(fields: [automationId], references: [id], onDelete: SetNull)

  enrollmentId String?
  enrollment   AutomationEnrollment? @relation(fields: [enrollmentId], references: [id], onDelete: SetNull)

  /// The number as dialled, E.164, or the email address as sent. Denormalised
  /// from the Customer because the question asked later is "where did this go",
  /// not "where would it go now" — people change numbers and addresses.
  to String?

  provider String?
  providerRef String?
  error  String?

  /// How many times a send has been attempted. 0 for a row that was skipped
  /// before any provider call; 1 once it's been tried; more after the retry
  /// sweep has had a go. A message failing every attempt looks different from
  /// one that blipped once, same as Refund.attempts.
  attempts Int @default(0)

  /// Whether a FAILED send is worth trying again. Populated from
  /// SendResult.retryable at send time — a landline or a disconnected handset
  /// fails identically forever and must not be retried; a provider timeout can.
  /// Null on rows that never failed. The retry sweep reads this so it never
  /// hammers a permanent failure.
  retryable Boolean?

  sentAt      DateTime?
  /// Carrier confirmation, arriving out of band via the status callback.
  /// Null is normal: the stub never sets it, and Twilio doesn't always report.
  deliveredAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([restaurantId, createdAt])
  @@index([customerId])
  @@index([providerRef])
  /// Drives the retry sweep — the set of sends still worth another attempt.
  @@index([status, retryable])
  /// Drives the campaign drain: the next batch of QUEUED rows for one campaign.
  @@index([campaignId, status])
  /// The automation drain, and the per-journey message list.
  @@index([automationId, status])
  @@index([enrollmentId])
  /// The outbox filtered by channel, which is how both dashboards read it.
  @@index([restaurantId, channel, createdAt])
}

/// A message an owner wrote and sent to an audience they chose.
///
/// ─── What this is not ─────────────────────────────────────────────────────
///
/// **A campaign is not a grant of consent, and an audience is not a consent
/// record.** This is the exact temptation `lib/customers.ts` warns about
/// — build an audience, then message it — arriving in the form that makes it
/// hardest to resist, because the whole feature looks like it exists to do
/// that. It doesn't. The audience decides *who is considered*; `lib/sms.ts`
/// and `lib/email.ts` decide who is actually contacted, and they read consent
/// columns and nothing else. A campaign targeting 400 people routinely sends
/// to 90 and records 310 SKIPPED rows with reasons. That gap is the feature
/// working, not a bug to close.
///
/// ─── Why recipients are Message rows ──────────────────────────────────────
///
/// There is no CampaignRecipient table. A recipient *is* a `Message` with a
/// `campaignId`, which means a campaign send passes through the same single
/// door every other message does, inherits the same consent gate, the same
/// retry sweep, the same delivery receipts and the same outbox. A parallel
/// table would be a second sending path, and a second sending path is a second
/// place for the consent rules to be almost right.
///
/// ─── Counters are a cache ─────────────────────────────────────────────────
///
/// `sentCount` and friends are derived from those Message rows and denormalised
/// so a list of fifty campaigns isn't fifty aggregate queries. They are
/// recomputed by `refreshCampaignCounts`, never incremented from a read — the
/// same lesson `Order.refundedCts` taught the hard way.
model Campaign {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  /// The owner's name for it, internal. Never sent.
  name    String
  channel MessageChannel
  status  CampaignStatus @default(DRAFT)

  /// The audience, stored as the query string `lib/customers.ts` already
  /// parses — the same representation `CustomerSegment.query` uses, and for
  /// the same reason: adding a filter must not need a migration, and a
  /// campaign saved before a filter existed should ignore it rather than fail.
  audienceQuery String @default("")

  /// The segment this was built from, if it was built from one. A hint for
  /// display only — `audienceQuery` is snapshotted at save time, so editing a
  /// segment afterwards never silently retargets a campaign that already ran.
  segmentId String?

  /// Email subject. Null on an SMS campaign.
  subject String?
  /// The message. SMS bodies are length-checked in lib/campaigns.ts; email
  /// bodies are plain text and converted to HTML at send time, because an
  /// owner composing raw HTML in a textarea is a rendering bug in every client
  /// at once.
  body String

  /// When the owner asked for it to go out. Null means "send on submit".
  /// Only meaningful in SCHEDULED.
  scheduledFor DateTime?

  startedAt   DateTime?
  completedAt DateTime?
  canceledAt  DateTime?

  /// Why a FAILED campaign failed, for the owner. Not a stack trace.
  error String?

  /// Denormalised counts — see the note above. `audienceCount` is how many the
  /// filter matched; the rest sum to it once the drain finishes.
  audienceCount Int @default(0)
  queuedCount   Int @default(0)
  sentCount     Int @default(0)
  failedCount   Int @default(0)
  skippedCount  Int @default(0)

  createdByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  messages Message[]

  @@index([restaurantId, createdAt])
  /// Drives the scheduler sweep: campaigns due to start, across all tenants.
  @@index([status, scheduledFor])
}

model SupportLog {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  weekOf DateTime
  hours  Float
  note   String?

  createdAt DateTime @default(now())

  @@index([restaurantId, weekOf])
}

/// Where a ticket or a contact enquiry is in its life.
///
/// `WAITING` is not decoration: it separates "I haven't looked at this" from
/// "I answered and it's on them now", which is the difference between a queue
/// that is behind and one that is merely open. Without it every answered
/// ticket either stays OPEN (and the count lies about the backlog) or gets
/// resolved prematurely to clear the number.
///
/// `ARCHIVED` is terminal and hides the row from the default view. It is not a
/// delete — the reason a tenant asked for something is what answers the
/// question six months later about why we changed it.
enum SupportStatus {
  OPEN
  WAITING
  RESOLVED
  ARCHIVED
}

enum SupportPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

/// What the ticket is about. Coarse on purpose — a taxonomy finer than the
/// person filing can reliably pick is a field that gets set to whatever is
/// first in the list, and then it is worse than no field.
enum SupportCategory {
  BUG
  BILLING
  MENU
  ORDERS
  MESSAGING
  ACCOUNT
  OTHER
}

/// One problem an owner reported to us.
///
/// Always attached to a tenant, because it is filed from inside the dashboard
/// and `requireOwner()` supplies the id — nothing accepts a `restaurantId`
/// from the client here any more than anywhere else. A contact-form enquiry
/// from a stranger is a different model on purpose; see `ContactSubmission`.
model SupportTicket {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  /// Who filed it. SetNull rather than Cascade: removing a staff account must
  /// not erase the history of what they reported.
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  /// Denormalized from the filer at creation. The account may be deleted or
  /// the address changed, and "who do I reply to about this" has to survive
  /// both.
  contactName  String
  contactEmail String

  subject  String
  category SupportCategory @default(OTHER)
  priority SupportPriority @default(NORMAL)
  status   SupportStatus   @default(OPEN)

  /// Human-readable and platform-sequential, so a ticket can be referred to
  /// out loud. Assigned by a database sequence rather than `max(number) + 1`:
  /// the read-then-write version is the bug class `docs/post-order-gaps.md`
  /// items 1–4 were about, and two owners filing in the same second would
  /// collide on the unique index. Gaps are fine — this is a label, not a count.
  number Int @unique @default(autoincrement())

  /// Set the first time an admin opens it. The gap between this and
  /// `createdAt` is first-response time, which is the only support metric an
  /// owner actually feels.
  firstReadAt DateTime?
  resolvedAt  DateTime?
  archivedAt  DateTime?

  /// Bumped by every message on either side. The list sorts on it, because a
  /// ticket the owner replied to an hour ago outranks one nobody has touched
  /// since it was filed a week back.
  lastActivityAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages SupportMessage[]
  notes    SupportNote[]

  @@index([status, lastActivityAt])
  @@index([restaurantId, status, lastActivityAt])
}

/// One turn in the conversation. **Both parties see every row in this table.**
///
/// That is the entire reason internal notes live in `SupportNote` rather than
/// here behind an `internal` boolean. A shared table with a visibility flag
/// puts "we should probably fire this customer" one forgotten `where` clause
/// away from the customer reading it, and the clause that protects it would
/// have to be correct in every query anyone ever writes. Two tables make the
/// mistake unavailable rather than merely discouraged.
model SupportMessage {
  id       String        @id @default(cuid())
  ticketId String
  ticket   SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  /// True when we wrote it, false when the owner did. Not a user id, because
  /// the answer the UI needs is "which side of the conversation", and a user
  /// row that gets deleted must not turn our reply into theirs.
  fromAdmin  Boolean
  authorName String
  body       String

  createdAt DateTime @default(now())

  @@index([ticketId, createdAt])
}

/// Admin-only working notes. Never rendered by anything under `/dashboard`,
/// never joined into an owner-facing query, and reachable only behind
/// `requireAdmin()`.
///
/// Exactly one of `ticketId` / `contactId` is set — enforced by a check
/// constraint in the migration, since Prisma can't express it. A note attached
/// to neither is a note nobody will ever find again.
model SupportNote {
  id String @id @default(cuid())

  ticketId String?
  ticket   SupportTicket? @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  contactId String?
  contact   ContactSubmission? @relation(fields: [contactId], references: [id], onDelete: Cascade)

  body     String
  authorId String?
  /// Denormalized for the same reason as `SupportTicket.contactEmail`.
  authorEmail String?

  createdAt DateTime @default(now())

  @@index([ticketId, createdAt])
  @@index([contactId, createdAt])
}

/// An enquiry from the public contact form.
///
/// Deliberately not a `SupportTicket` with a null tenant. The endpoint is
/// unauthenticated, so this table is the one place in the product where a
/// stranger can write a row, and it inherits the consequences: it holds spam,
/// it needs rate limiting, and nothing in it may ever be trusted to name a
/// tenant. Keeping it separate means the owner-facing ticket queries can't
/// accidentally surface an unverified row, and the abuse handling for one
/// doesn't have to be reasoned about while reading the other.
model ContactSubmission {
  id String @id @default(cuid())

  name    String
  email   String
  /// Optional throughout — a prospect who won't leave a number still deserves
  /// a reply, and a required field here just gets a fake value typed into it.
  phone        String?
  business     String?
  message      String
  /// Which page they came from. Coarse, for knowing whether pricing converts.
  sourcePath String?

  status SupportStatus @default(OPEN)

  /// Best-effort attribution when the email happens to match an existing
  /// owner login. Advisory only — it is a convenience for us, never an auth
  /// decision, because the address on this form was never verified.
  matchedRestaurantId String?

  readAt     DateTime?
  resolvedAt DateTime?
  archivedAt DateTime?

  createdAt DateTime @default(now())

  notes SupportNote[]

  @@index([status, createdAt])
  @@index([email])
}

/// The services the platform can switch off for a single tenant. Each maps to
/// a capability the tenant is *sold*, not a feature flag — which is why the
/// list is short and why turning one off is recorded rather than toggled.
enum ServiceKind {
  PAYMENTS
  SMS
  EMAIL
  DELIVERY
}

/// An admin turning a service off for one tenant — suspension, not preference.
///
/// The table is append-only in spirit: lifting a suspension sets `liftedAt`
/// rather than deleting the row, so "when did we cut them off, who did it, why,
/// and when did it come back" survives. That history is the whole point. A
/// billing dispute or an angry owner is answered from this table.
///
/// A row with `liftedAt` null is in force. A partial unique index (see the
/// migration) guarantees at most one live row per tenant per service, so two
/// admins racing cannot leave two active suspensions that need lifting twice.
///
/// Owners can never write here — every mutation goes through lib/entitlements.ts
/// behind requireAdmin(). That asymmetry is the feature: a suspended owner must
/// not be able to restore their own service.
model ServiceSuspension {
  id           String      @id @default(cuid())
  restaurantId String
  restaurant   Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  service      ServiceKind

  /// Shown to the owner. Write it as though they will read it, because they do.
  reason      String?
  /// Internal note — never rendered outside /admin.
  internalNote String?

  suspendedAt DateTime  @default(now())
  suspendedBy String?
  liftedAt    DateTime?
  liftedBy    String?

  @@index([restaurantId, service])
  @@index([service, liftedAt])
}

/// Platform-wide payment mode. LIVE charges real money against the live keys;
/// TEST runs real Stripe charges against the test keys (visible in the Stripe
/// test dashboard, refundable, no real money); STUB takes nothing and reports
/// success. The point of the enum living in the database rather than an env var
/// is that "us" can flip it from /admin without a redeploy — so a production
/// deploy with the real keys installed can still be exercised end to end.
enum PaymentMode {
  LIVE
  TEST
  STUB
}

/// Single-row table of platform settings. The fixed id keeps it a singleton:
/// every read and write targets "singleton", so there is exactly one row and no
/// way to accidentally create a second. Absent row means "never configured" —
/// callers fall back to the PAYMENT_MODE env default.
model PlatformSetting {
  id          String      @id @default("singleton")
  paymentMode PaymentMode @default(STUB)
  updatedAt   DateTime    @updatedAt
  updatedById String?

  /// When a non-LIVE mode stops being allowed. Null means "no timer".
  ///
  /// TEST and STUB are both states where a customer completes checkout, the
  /// kitchen makes the food, and no money arrives — STUB worse than TEST, since
  /// Stripe has no record of it at all. Left on by accident that is a restaurant
  /// giving away dinners, so the mode carries an expiry rather than trusting
  /// somebody to remember. Enforced in `resolvePaymentMode()`, which is the one
  /// door every charge and refund reads.
  modeExpiresAt DateTime?

  /// What to fall back to when the window closes. See `lib/payments.ts` for why
  /// this is not blindly LIVE.
  modeRevertTo PaymentMode?

  /// Set when the timer fires, so the banner can say "this reverted on its own"
  /// rather than leaving an admin to wonder who changed it.
  modeRevertedAt DateTime?

  /// Shows the demo scaffolding — signup/onboarding autofill, tenant seeding,
  /// the sample CSV. Off by default and independent of `paymentMode`: wiring
  /// them together would mean testing a real payment flow requires exposing
  /// autofill buttons to real owners.
  testModeEnabled Boolean @default(false)

  /// Operator-edited wording for the manual onboarding checklist, so the text
  /// of a step can be changed from the admin UI without a code deploy. Shape is
  /// `{ [stepKey]: { label?, detail? } }`, applied over the code catalog in
  /// `lib/onboarding-checklist.ts`. The catalog still owns the *structure* —
  /// which steps exist, their order, their deep links — because adding a step
  /// needs a stable key; this only overrides the two strings a human reads.
  /// Platform-wide: there is one master checklist, not one per tenant.
  onboardingStepOverrides Json @default("{}")
}

// ===========================================================================
// Storefront analytics
// ===========================================================================
//
// Two tables, deliberately. `Visit` is the row an owner's questions are
// actually about ("how many people looked, how long did they stay, did they
// buy") and it is small enough to aggregate over a year without help.
// `VisitEvent` is the append-only detail underneath it, one row per thing that
// happened, and it grows tens of times faster.
//
// Splitting them means the expensive table is only touched by the handful of
// breakdowns that genuinely need it (item funnels, search terms, drop-off
// points), while every headline number — sessions, conversion, dwell time,
// revenue — reads the cheap one. A single events table would have made the
// dashboard's first paint a full scan of the largest table in the database.

/// What a customer did. Kept as an enum rather than free text because these
/// drive funnel maths — a typo'd string would silently vanish from a
/// conversion rate rather than failing loudly.
enum VisitEventKind {
  PAGE_VIEW // landed on the storefront
  VIEW_CHANGE // landing -> menu -> cart -> checkout
  ITEM_VIEW // opened an item's detail sheet
  ITEM_ADD // added to cart (quick-add or from the sheet)
  ITEM_REMOVE // removed a line, or dropped its quantity to zero
  CART_VIEW // opened the cart
  CHECKOUT_START // opened the checkout sheet
  CHECKOUT_ERROR // submission bounced (declined card, closed kitchen, ...)
  ORDER_PLACED // the one that pays for all the others
  SEARCH // typed a query into the menu search
  HEARTBEAT // still here — see Visit.dwellMs for why this exists
}

/// Where the customer came from. Derived from the referrer on the server and
/// then thrown away, because a raw referrer is a tracking surface we have no
/// use for and a liability we'd rather not hold.
enum VisitSource {
  DIRECT // typed, bookmarked, or a PWA launch
  QR // ?src=qr — the table tent and the counter card
  SEARCH_ENGINE
  SOCIAL
  MAPS
  SMS // a link we texted them
  REFERRAL // some other site
  UNKNOWN
}

enum VisitDevice {
  MOBILE
  TABLET
  DESKTOP
  UNKNOWN
}

/// One customer, one sitting, one storefront.
///
/// The `anonId` is generated in the browser and stored in localStorage — it is
/// not derived from an IP or a fingerprint, so it survives nothing the
/// customer clears and identifies nobody. It exists purely to tell "one person
/// who came back four times" apart from "four people", which is the difference
/// between a regular and a rush.
model Visit {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  /// Browser-generated, localStorage-scoped, per-tenant. Never a phone number,
  /// never an IP, never joined to `Customer` — a visit is anonymous until it
  /// becomes an order, and the order is where identity already lives.
  anonId String

  /// Set only once the visit places an order. This is the join that makes
  /// "what did the people who bought do differently" answerable at all.
  orderId String?
  order   Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)

  startedAt DateTime @default(now())
  /// Bumped by every event, including heartbeats. Combined with startedAt this
  /// is the dwell time, and it is stored rather than computed because the
  /// alternative is a correlated subquery over the events table per row.
  lastSeenAt DateTime @default(now())

  /// Milliseconds between first and last sign of life, clamped at ingest.
  ///
  /// A browser tab left open overnight is not a four-hour visit, and one
  /// un-clamped row like that moves a tenant's average session length more
  /// than a hundred real ones. `MAX_DWELL_MS` in lib/analytics.ts is the cap.
  dwellMs Int @default(0)

  source   VisitSource @default(UNKNOWN)
  device   VisitDevice @default(UNKNOWN)
  /// Coarse only — the referring host, never a full URL with its query string.
  referrerHost String?

  // --- Funnel milestones -------------------------------------------------
  // Denormalized onto the visit because these five booleans are the entire
  // conversion funnel, and reading them off the events table would mean five
  // grouped scans of it for the single most-viewed chart in the product.
  viewedMenu     Boolean @default(false)
  viewedItem     Boolean @default(false)
  addedToCart    Boolean @default(false)
  startedCheckout Boolean @default(false)
  converted      Boolean @default(false)

  eventCount Int @default(0)

  /// True when the visit came from `lib/simulator.ts` rather than a person.
  /// Same role as `paymentProvider: "sim"` on an order: it is the only thing
  /// that makes a wipe safe against a tenant that also has real trade, and
  /// every query in `lib/analytics-query.ts` filters on it by default.
  simulated Boolean @default(false)

  events VisitEvent[]

  @@unique([restaurantId, anonId, startedAt])
  @@index([restaurantId, startedAt])
  @@index([restaurantId, converted, startedAt])
  @@index([restaurantId, simulated, startedAt])
  @@index([orderId])
}

/// One thing that happened, append-only. Never updated, never deleted except
/// by a tenant cascade or a simulated-data wipe.
model VisitEvent {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  visitId String
  visit   Visit  @relation(fields: [visitId], references: [id], onDelete: Cascade)

  kind VisitEventKind
  at   DateTime       @default(now())

  /// Which item this was about. SetNull rather than Cascade: deleting a menu
  /// item must not rewrite the history of orders that contained it.
  itemId String?
  item   MenuItem? @relation(fields: [itemId], references: [id], onDelete: SetNull)

  /// The screen the customer was on. Free text because the storefront's view
  /// names are its own business and adding one shouldn't need a migration.
  view String?

  /// Money implied by the event — a cart-add's line total, an order's total.
  /// Integer cents like everywhere else in this codebase.
  valueCts Int?

  /// How long the customer sat on the previous view before this event. The
  /// per-screen half of dwell time; `Visit.dwellMs` is the whole-visit one.
  dwellMs Int?

  /// Search terms and error codes only. Explicitly not a general-purpose bag:
  /// `lib/analytics.ts` allowlists the keys it will store, because a `meta`
  /// field with no gate is how a phone number ends up in an analytics table.
  label String?

  simulated Boolean @default(false)

  @@index([restaurantId, at])
  @@index([restaurantId, kind, at])
  @@index([visitId, at])
  @@index([itemId, kind])
}


/// A storefront sign-in for a diner, scoped to one restaurant.
///
/// Scoped deliberately. Someone who signs in at two restaurants on the platform
/// has two accounts and neither can see the other — the same isolation every
/// other customer-shaped table has. One platform-wide identity would turn each
/// tenant's customer list into a shared directory, and that list is the product.
///
/// **An account is not consent and is not a Customer.** `customerId` stays null
/// until a phone number arrives at checkout, because `Customer.phone` is the
/// dedupe key for the tenant's list and an email address cannot stand in for
/// it. Signing in with Apple grants a view of past orders; it grants nothing to
/// `lib/sms.ts`, which reads `optInStatus` and nothing else.
model CustomerAccount {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  provider String  // "google" | "apple"
  subject  String
  email    String?
  name     String?

  /// Linked at first checkout, never at sign-in. SET NULL on delete rather than
  /// cascade: a privacy deletion of the Customer row must not silently destroy
  /// the login someone uses to reach their order history.
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  createdAt   DateTime  @default(now())
  lastLoginAt DateTime?

  @@unique([restaurantId, provider, subject])
  @@index([restaurantId])
  @@index([customerId])
}


/// Every plan change, append-only.
///
/// Kept as history rather than only as current state, because "what were they
/// on in March and who moved them" is what answers a billing dispute — the same
/// reasoning as `ServiceSuspension` keeping lifted rows. A tenant whose plan
/// silently changed under them during a grace-period lapse especially needs a
/// record they can be shown.
model PlanChange {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  fromPlan Plan
  toPlan   Plan

  /// "owner" | "admin" | "dunning" — who or what moved it. A lapse is the one
  /// nobody chose, and it is the one most likely to be argued about later.
  source String

  /// The user who did it, when a person did. Null for an automatic lapse.
  actorId String?

  /// When it actually took effect, which is not when the row was written for a
  /// change scheduled at the period boundary.
  effectiveAt DateTime

  createdAt DateTime @default(now())

  @@index([restaurantId, createdAt])
}


// ---------------------------------------------------------------------------
// Booking calendar
// ---------------------------------------------------------------------------

enum BookingStatus {
  SCHEDULED
  CANCELED
  ATTENDED
  NO_SHOW
}

/// A kind of call that can be booked, and the rules that decide when.
///
/// Modelled as a row rather than a constant because the two calls that exist
/// are not the same product: an onboarding call is us walking a paying tenant
/// through setup and gets generous availability, a sales call from `/contact`
/// is a stranger and gets less. Same engine, different windows — and the day
/// there are three, nothing has to be rewritten.
///
/// `availabilityJson` is the same `WeeklyHours` shape as `Restaurant.hoursJson`
/// and is parsed by the same `parseWeeklyHours`. Deliberate: two formats for
/// "a weekly schedule" is two sets of edge cases around midnight and DST, and
/// that code is already written and tested.
model BookingType {
  id   String @id @default(cuid())
  slug String @unique
  name String

  /// Shown above the slot picker. What the call is for, in the booker's terms.
  blurb String?

  /// How long the call runs. The slot grid is built from this.
  durationMins Int @default(10)

  /// Dead time after a call before the next slot may start. Back-to-back calls
  /// with no gap is how one overrunning call makes every later one late.
  bufferMins Int @default(5)

  /// How soon a booking may be made. Two hours by default — a slot bookable
  /// five minutes out is one nobody sees in time to attend.
  minNoticeMins Int @default(120)

  /// How far ahead the picker shows. A calendar open six months out fills with
  /// bookings nobody remembers agreeing to.
  maxDaysAhead Int @default(21)

  /// Weekly bookable windows, in `timezone`. Null means nothing is bookable —
  /// the opposite default from `Restaurant.hoursJson`, and deliberately so.
  /// Hours fail *open* because a restaurant with no schedule should keep
  /// trading; a calendar with no schedule must not hand out slots at 4am.
  availabilityJson Json?

  /// The host's timezone. Every window above is wall-clock time here, exactly
  /// as `Restaurant.hoursJson` is wall-clock in the restaurant's own zone.
  timezone String @default("America/New_York")

  /// Static fallback meeting URL, used when a booking carries none of its own.
  /// A per-booking link (a Zapier-created Zoom room) wins when present.
  meetingUrl String?

  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bookings Booking[]

  @@index([active])
}

/// One booked call.
///
/// `restaurantId` is nullable on purpose. A booking from `/contact` is a
/// stranger who has no tenant yet, and inventing one to satisfy a foreign key
/// would put a fake restaurant in every count on the admin home. Same reasoning
/// as `ContactSubmission.matchedRestaurantId`, and the same consequence: the
/// admin calendar shows unattached bookings as unattached rather than hiding
/// them.
///
/// The double-booking guard is a **partial** unique index on
/// (typeId, startsAt) WHERE status = 'SCHEDULED', which lives in the migration
/// rather than here because Prisma cannot express a partial index — the same
/// arrangement as `ServiceSuspension`. It has to be partial: a canceled 2pm
/// must leave 2pm bookable, and a plain unique constraint would make one
/// cancellation burn that slot permanently.
model Booking {
  id     String      @id @default(cuid())
  typeId String
  type   BookingType @relation(fields: [typeId], references: [id], onDelete: Cascade)

  restaurantId String?
  restaurant   Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: SetNull)

  name  String
  email String
  phone String?

  /// What they want to talk about. Free text, shown to the host before the call.
  note String?

  startsAt DateTime
  endsAt   DateTime

  /// The zone the booker was shown times in. Kept so a confirmation or a
  /// reschedule can speak in their terms rather than ours — "2pm" means
  /// different things to the two people on the call.
  bookerTimezone String?

  status BookingStatus @default(SCHEDULED)

  /// Per-booking meeting URL when something upstream made one. Falls back to
  /// `BookingType.meetingUrl`; resolved in one place by `meetingUrlFor()`.
  meetingUrl String?

  /// Manage-your-booking auth. The token *is* the credential, exactly as it is
  /// for `/o/[token]` — a stranger booking a sales call has no account to log
  /// in to, and requiring one to cancel guarantees no-shows instead.
  publicToken String @unique

  canceledAt DateTime?
  attendedAt DateTime?

  /// "web" | "admin" — who created it. An admin-entered booking is a call
  /// agreed somewhere else and typed in, and it should not look like a
  /// self-serve one when the funnel is counted.
  source String @default("web")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([startsAt])
  @@index([status, startsAt])
  @@index([restaurantId])
  @@index([email])
}

// ---------------------------------------------------------------------------
// Automations — the visual journey builder
//
// See docs/automations.md. The short version of the rules that shaped these
// tables:
//
//   - An automation decides *when* to send. It never sends. Every SEND block
//     goes through lib/sms.ts or lib/email.ts, which re-run the consent gate
//     at the instant of the send — weeks after the owner drew the box, which
//     is exactly why checking at save time would be worthless.
//   - A message an automation sends is a Message row, not a row in a parallel
//     recipient table. Same reason campaigns have no CampaignRecipient.
//   - An enrollment runs the graph version it entered on, pinned. Editing a
//     live automation must not teleport someone to node 7 of a graph whose
//     node 7 no longer exists.
// ---------------------------------------------------------------------------

/// Where an automation is in its own lifecycle. Distinct from an enrollment's
/// status — an ARCHIVED automation may still have people finishing journeys.
enum AutomationStatus {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED
}

/// What one customer's trip through one automation is doing.
///
/// WAITING and ACTIVE are both "in flight" and both block re-enrollment; the
/// split exists so the drain can find the ones whose timer has expired without
/// walking every live journey.
enum EnrollmentStatus {
  ACTIVE
  WAITING
  COMPLETED
  EXITED
  FAILED
  CANCELED
}

/// What happens to a customer who qualifies for an automation they have
/// already been through. Default ONCE — see docs/automations.md for why the
/// two failure modes are not symmetric.
enum ReentryPolicy {
  ONCE
  ONCE_PER_TRIGGER
  COOLDOWN
  ALWAYS
}

enum TemplateStatus {
  DRAFT
  PUBLISHED
  RETIRED
}

/// What a publish does to the tenants already running a template. Three
/// answers, all legitimate, chosen per template by the admin. See
/// docs/automations.md — the table there is the specification.
enum TemplateSyncPolicy {
  ALWAYS
  AUTO_UNLESS_CUSTOMIZED
  OPT_IN
}

model Automation {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  name   String
  status AutomationStatus @default(DRAFT)

  /// What starts a journey, and its parameters. A string rather than an enum
  /// on purpose: the whole node vocabulary lives in `lib/automation-flow.ts`
  /// because the graph is JSON anyway, and an enum here would put half the
  /// vocabulary in the schema and make adding a block a migration.
  triggerType   String
  triggerConfig Json?

  reentry      ReentryPolicy @default(ONCE)
  /// Only meaningful with COOLDOWN.
  reentryDays  Int           @default(30)

  /// The window, in the restaurant's own timezone, in which this automation
  /// may send. An owner's campaign goes out when they press a button, so a
  /// human is implicitly vetting the hour; an automation's wait can land at
  /// 3am. A send outside the window is deferred to the next opening rather
  /// than dropped.
  quietStartMin Int @default(540)  // 09:00
  quietEndMin   Int @default(1200) // 20:00

  /// The version currently handed to new entrants. Null on a draft that has
  /// never been published.
  activeVersionId String?           @unique
  activeVersion   AutomationVersion? @relation("ActiveVersion", fields: [activeVersionId], references: [id], onDelete: SetNull)

  /// The graph the owner is editing right now. Saving edits this; activating
  /// freezes it into an AutomationVersion. Nothing in flight ever reads it.
  draftGraph Json?

  // --- Template linkage --------------------------------------------------
  //
  // Null on an automation the owner drew themselves. The three fields answer
  // three different questions and none of them substitutes for another:
  // which template this came from, which version of it we last took, and
  // whether the owner has since edited it (which severs the link under
  // AUTO_UNLESS_CUSTOMIZED and is merely recorded under OPT_IN).

  templateId        String?
  template          AutomationTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  templateVersionId String?
  /// When the owner first edited an adopted template. Non-null means "this is
  /// theirs now" for sync purposes.
  templateForkedAt  DateTime?
  /// Set by a publish the owner has to accept. Cleared when they do.
  templateUpdateAvailableVersionId String?

  /// The inbound webhook credential, for WEBHOOK triggers. Minted on demand,
  /// 160 bits, and the URL is the auth — same contract as `Order.publicToken`.
  hookToken String? @unique

  /// Denormalised, recomputed rather than incremented. `Order.refundedCts`
  /// taught this repo what read-then-increment costs.
  enteredCount   Int @default(0)
  completedCount Int @default(0)
  goalCount      Int @default(0)

  createdByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  activatedAt     DateTime?

  versions    AutomationVersion[]    @relation("AutomationVersions")
  enrollments AutomationEnrollment[]
  messages    Message[]

  @@index([restaurantId, status])
  /// The event fan-out: every automation in a tenant listening for one trigger.
  @@index([restaurantId, triggerType, status])
  /// The sweep's cross-tenant scan for time-based triggers.
  @@index([status, triggerType])
  @@index([templateId])
}

/// A frozen graph. Immutable once written.
///
/// This is what makes "an enrollment runs the version it entered on" true
/// rather than aspirational. It is also the audit record — "what did the
/// journey that texted my customer in April actually say" has to be
/// answerable after the owner has redrawn it twice.
model AutomationVersion {
  id           String     @id @default(cuid())
  automationId String
  automation   Automation @relation("AutomationVersions", fields: [automationId], references: [id], onDelete: Cascade)

  version Int
  graph   Json

  /// Snapshotted alongside the graph, because a trigger change is a change to
  /// what the journey *is*, and an enrollment pinned to a version should be
  /// readable without consulting the mutable parent row.
  triggerType   String
  triggerConfig Json?

  /// Where this graph came from, when it came from a template.
  templateVersionId String?

  createdByUserId String?
  createdAt       DateTime @default(now())

  activeFor   Automation?            @relation("ActiveVersion")
  enrollments AutomationEnrollment[]

  @@unique([automationId, version])
}

/// One customer's trip through one automation.
model AutomationEnrollment {
  id           String     @id @default(cuid())
  automationId String
  automation   Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)

  /// Denormalised from the automation so every read in this table is tenant
  /// scoped without a join — the same rule every owner query follows.
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  versionId String
  version   AutomationVersion @relation(fields: [versionId], references: [id], onDelete: Restrict)

  status EnrollmentStatus @default(ACTIVE)

  /// Where they are. Null once the journey has ended.
  currentNodeId String?

  /// When the drain should look at this again. Null on an ACTIVE enrollment
  /// that is due immediately, and on anything terminal.
  resumeAt DateTime?

  /// Trigger payload and anything a node has computed — order total, the tag
  /// that fired it, split assignment. Read by condition evaluation.
  ///
  /// A JSON bag is acceptable here and is *not* acceptable on VisitEvent (see
  /// docs/analytics.md), and the difference is who writes it: this is written
  /// server-side from data we already hold about a customer we already have,
  /// never from a public unauthenticated beacon.
  context Json?

  /// Which side of a SPLIT they landed on, assigned once and recorded so a
  /// result can be attributed later.
  variant String?

  /// How many nodes this journey has traversed, ever. The second belt on the
  /// acyclic validator — a cycle that slipped through is an infinite loop that
  /// sends a message every time round, and a budget turns that into a stuck
  /// enrollment somebody notices rather than a phone ringing all night.
  steps Int @default(0)

  goalMetAt  DateTime?
  /// Why it ended, in a word: "completed", "goal", "exit_block",
  /// "trigger_no_longer_matches", "canceled_by_owner", "step_budget",
  /// "customer_unreachable". Shown to the owner as a sentence.
  exitReason String?

  enteredAt DateTime  @default(now())
  endedAt   DateTime?
  updatedAt DateTime  @updatedAt

  stepLog  AutomationStep[]
  messages Message[]

  /// The drain's claim query: everything due, oldest first.
  @@index([status, resumeAt])
  @@index([automationId, status])
  @@index([restaurantId, enteredAt])
  @@index([customerId])
  /// The re-entry guard is a **partial** unique index and Prisma can't express
  /// it — see the migration. `(automationId, customerId) WHERE status IN
  /// ('ACTIVE','WAITING')`. Partial, or somebody who finished in March can
  /// never enter again.
}

/// Append-only. What happened at each node, for one enrollment.
///
/// This is the thing that answers "why did my customer get that text", and it
/// is deliberately a row per node rather than a summary: the interesting cases
/// are the ones where nothing visible happened — a condition went the other
/// way, a send was skipped by the consent gate, a quiet-hours deferral moved a
/// message by nine hours.
model AutomationStep {
  id           String               @id @default(cuid())
  enrollmentId String
  enrollment   AutomationEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  nodeId   String
  nodeKind String

  /// "ok" | "skipped" | "failed" | "waiting" | "branch_true" | "branch_false"
  /// | "timeout" | "deferred"
  outcome String

  /// One human sentence. Not a stack trace — this is shown to the owner.
  detail String?

  /// The message this step produced, when it produced one.
  messageId String?

  createdAt DateTime @default(now())

  @@index([enrollmentId, createdAt])
}

/// A journey we wrote, that owners can adopt.
model AutomationTemplate {
  id       String @id @default(cuid())
  name     String
  slug     String @unique
  /// One sentence in the gallery. What it does, not how.
  blurb    String?

  /// Who sees this template. A String, not an enum, for the same reason node
  /// kinds are — the vocabulary lives in lib/automation-templates.ts.
  ///   PRIVATE — admins only. Experiments and half-built drafts.
  ///   OWNERS  — shown in the owner gallery to adopt by hand (the default).
  ///   PRESET  — a done-for-you reordering preset: shown to owners AND driven
  ///             by the dial when its slug is a reorder- level.
  /// See docs/reorder-dfy.md.
  visibility String @default("OWNERS")

  status TemplateStatus @default(DRAFT)

  /// See docs/automations.md. AUTO_UNLESS_CUSTOMIZED is the recommended
  /// default and the one the gallery marks as such.
  syncPolicy TemplateSyncPolicy @default(AUTO_UNLESS_CUSTOMIZED)

  triggerType   String
  triggerConfig Json?

  /// What the admin is editing. Never visible to an owner — a half-finished
  /// edit being live in forty tenants is the failure this separation exists to
  /// prevent.
  draftGraph Json?

  publishedVersionId String?                    @unique
  publishedVersion   AutomationTemplateVersion? @relation("PublishedVersion", fields: [publishedVersionId], references: [id], onDelete: SetNull)

  /// Recomputed. How many live automations point at this.
  adoptionCount Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  versions    AutomationTemplateVersion[] @relation("TemplateVersions")
  automations Automation[]

  @@index([status])
}

model AutomationTemplateVersion {
  id         String             @id @default(cuid())
  templateId String
  template   AutomationTemplate @relation("TemplateVersions", fields: [templateId], references: [id], onDelete: Cascade)

  version Int
  graph   Json

  triggerType   String
  triggerConfig Json?

  /// What changed, for the "an update is available" panel an owner reads
  /// before accepting it. An owner asked to accept a change they can't see is
  /// being asked to trust rather than to decide.
  notes String?

  publishedByUserId String?
  publishedAt       DateTime @default(now())

  publishedFor AutomationTemplate? @relation("PublishedVersion")

  @@unique([templateId, version])
}

/// A "build my menu for me" request an owner submits during onboarding.
///
/// The menu is the hardest, slowest part of onboarding — retyping forty items
/// with prices and modifiers is where a setup gets abandoned. So the wizard
/// offers a second path: the owner hands over whatever they already have (a
/// link to their DoorDash/Toast page, a block of pasted menu text, and photos
/// of a printed menu) and we build it for them by hand before their setup call.
///
/// This is a *submission*, never a menu. Nothing here writes `MenuItem` — same
/// principle as `lib/menu-scrape.ts`, where a scrape is a proposal an owner
/// approves. The rows are worked from the admin side. `itemCount > 0 OR a
/// submission exists` is what satisfies the onboarding menu gate, so an owner
/// who chose "do it for me" is not blocked waiting on us.
model MenuSubmission {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  /// One or more links the owner pasted — a delivery-app page, their website,
  /// a Google Doc. Free-form; we fetch/read them by hand.
  links String[] @default([])

  /// Menu text the owner pasted straight in. The richest single signal, since
  /// it usually carries names, prices and descriptions already.
  pastedText String?

  /// Uploaded photos of a printed/physical menu. Stored URLs, same as logos.
  photoUrls String[] @default([])

  /// Anything else the owner wants us to know — "prices went up last week",
  /// "ignore the catering section", etc.
  notes String?

  /// Set once we've built the menu from this submission. Non-null = handled.
  /// Rows are never deleted, so "what did they send us, and did we do it" stays
  /// answerable.
  fulfilledAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([restaurantId, fulfilledAt])
  @@index([fulfilledAt, createdAt])
}

// ===========================================================================
// Platform notifications
// ===========================================================================
//
// One row per recipient per event. A "notify the admins" call fans out into
// one Notification per admin User at creation time rather than storing a single
// broadcast row read by many — that keeps read/unread state a plain column on
// the row the reader owns, instead of a join table that has to be kept in step.
// Admins are few and a broadcast to owners is bounded, so the fan-out is cheap.
//
// The kind vocabulary, default severity, and default per-channel delivery live
// in code (src/lib/notification-format.ts), not here — the same split as the
// onboarding checklist: the enum owns *which kinds exist*, the catalog owns the
// two strings and three booleans a human reads and tunes. Delivery (in-app,
// email, SMS) is decided at the one door, src/lib/notifications.ts.

/// What happened. An enum rather than free text because preferences and the
/// per-kind delivery catalog key off it — a typo'd string would silently opt a
/// recipient out of an alert they asked for.
enum NotificationKind {
  ORDER_PLACED
  REFUND_FAILED
  SUPPORT_TICKET
  CONTACT_FORM
  BOOKING_CREATED
  BOOKING_REMINDER
  MENU_SUBMISSION
  NEW_OPERATOR
  SERVICE_SUSPENDED
  PAYMENT_MODE_REVERTED
  PLAN_CHANGED
  /// A message an admin composed by hand — a platform announcement to owners,
  /// or a reminder an operator set for themselves (a meeting, a follow-up).
  BROADCAST
  REMINDER
}

/// How loud. Drives ordering and the badge colour, and is the reason a failed
/// refund doesn't sink to the bottom of the same list as a menu submission.
enum NotificationSeverity {
  INFO
  WARNING
  URGENT
}

model Notification {
  id       String @id @default(cuid())

  /// The recipient. Always set — every notification belongs to exactly one
  /// person's inbox, and a fan-out writes one row each. Indexed because the
  /// inbox and the unread badge both read "mine, newest first".
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  kind     NotificationKind
  severity NotificationSeverity @default(INFO)

  title    String
  body     String
  /// Where clicking it goes — an in-app path like /admin/support/123. Nullable
  /// for notes that have no destination.
  link     String?

  /// The tenant this concerns, when it concerns one. A platform-level alert
  /// (mode reverted, a broadcast) leaves it null. Not an auth field — the
  /// recipient is userId; this is context for the reader.
  restaurantId String?

  /// Collapses duplicates. A second identical alert to the same user (two order
  /// webhooks a second apart, a re-render) is dropped by the partial unique
  /// index below rather than stacking. Null opts out of dedupe.
  dedupeKey String?

  /// When it becomes visible. Null (the common case) means "now". A reminder an
  /// operator sets for next Tuesday carries a future timestamp and is hidden
  /// from the inbox and the unread count until then — the queue drain also
  /// leaves outbound delivery for it until the clock passes.
  scheduledFor DateTime?

  readAt   DateTime?

  /// Outbound delivery bookkeeping. Set when the email/SMS actually left the
  /// building, so a resend or the queue drain can tell "in-app only, still
  /// owes an email" from "fully delivered". Null on a channel the resolved
  /// preference didn't ask for, too — the columns answer "did we send it",
  /// read together with the recipient's preference.
  emailedAt DateTime?
  smsedAt   DateTime?

  /// When the one outbound-delivery pass ran for this row — immediately at
  /// creation for a live notification, at drain time for a scheduled one. The
  /// marker the drain filters on: a future reminder sits with `deliveredAt`
  /// null until its `scheduledFor` passes, and is picked up exactly once. It
  /// says "we decided the channels and sent what was asked", which is distinct
  /// from `emailedAt`/`smsedAt` (which stay null on a kind the recipient
  /// receives in-app only) — so a re-drain can tell "not yet processed" from
  /// "processed, email not wanted".
  deliveredAt DateTime?

  /// Who created it, for the hand-composed kinds (BROADCAST, REMINDER). Plain
  /// string, no relation — same shape as PlatformSetting.updatedById.
  createdById String?

  createdAt DateTime @default(now())

  @@index([userId, readAt, scheduledFor])
  @@index([userId, createdAt])
  // The partial unique index that actually enforces dedupe lives in the
  // migration (Prisma can't express a WHERE on a unique index): one live row
  // per (userId, dedupeKey) where dedupeKey is not null.
}

/// Per-user, per-kind channel overrides. An absent row means "use the catalog
/// default" (src/lib/notification-format.ts) — so a fresh operator has sensible
/// delivery with zero rows written, and only a deliberate change persists. The
/// same absent-row-is-default contract as the onboarding step overrides.
model NotificationPref {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind   NotificationKind

  inApp Boolean @default(true)
  email Boolean @default(false)
  sms   Boolean @default(false)

  updatedAt DateTime @updatedAt

  @@unique([userId, kind])
}
