{
  "name": "ez-shots",
  "version": "1.0.0",
  "description": "EZ Shots, real estate photography website for Metro Detroit realtors",
  "scripts": {
    "start": "node server.js",
    "dev": "node --env-file-if-exists=.env server.js",
    "start:static": "serve . -l ${PORT:-3000}",
    "check:forms": "node scripts/check-forms.mjs",
    "test": "node scripts/check-forms.mjs && node scripts/check-availability.mjs && node scripts/check-ghl.mjs",
    "check:emails": "node scripts/preview-emails.mjs",
    "check:bookings": "node scripts/check-bookings.mjs",
    "blog:write": "node --env-file-if-exists=.env scripts/write-blog.mjs",
    "seo": "node scripts/build-seo.mjs",
    "check:fulfillment": "node scripts/check-fulfillment.mjs && CHECK_STORAGE=postgres node scripts/check-fulfillment.mjs"
  },
  "dependencies": {
    "heic-decode": "^2.1.0",
    "nodemailer": "^6.10.1",
    "pg": "^8.23.0",
    "serve": "^14.2.1",
    "sharp": "^0.34.5"
  }
}
