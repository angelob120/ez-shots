{
  // Support. Only the pure half is under test — the status machine, the
  // timestamp rules, and the validators — so the exploding Prisma stub is the
  // right one: anything that reaches for the database here has wandered out of
  // scope and should fail loudly rather than quietly pass.
  //
  // `server-only` is swapped for the usual reason: it resolves to a module that
  // throws unless the react-server condition is set, which is exactly what makes
  // it useless under tsx.
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "baseUrl": "..",
    "paths": {
      "@/lib/prisma": ["./scripts/test-stubs/prisma.ts"],
      "server-only": ["./scripts/test-stubs/server-only.ts"],
      "@/*": ["./src/*"]
    }
  }
}
