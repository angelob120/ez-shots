{
  // Customer import and search. Only the pure halves are exercised — the CSV
  // mapper (which has no server dependencies at all) and the `where`/param
  // builders in `lib/customers.ts`. The exploding Prisma stub is deliberate:
  // anything here that reaches the database has wandered out of scope and
  // should fail loudly rather than quietly pass against a fake.
  //
  // `server-only` is swapped for the usual reason — it resolves to a module
  // that throws unless the react-server condition is set, which is exactly
  // what makes it useless under tsx.
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "baseUrl": "..",
    "paths": {
      "@/lib/prisma": ["./scripts/test-stubs/prisma.ts"],
      "server-only": ["./scripts/test-stubs/server-only.ts"],
      "@/*": ["./src/*"]
    }
  }
}
